# Extracted game assets (10 GiB, regenerable from bundles) — never track
/res/

# Third-party tooling, venv, nuget cache, BepInEx payloads (audit tooling is tracked)
/tools/*
!/tools/audit/

# Unity reconstruction audit: regenerable bulk outputs
/tools/audit/out/a03_cache/
/tools/audit/out/a03/
/tools/audit/out/containers_by_kind.csv
/tools/audit/out/unresolved_references.csv
/tools/audit/*.log

# Machine-specific absolute paths for the audit/integration tooling (never commit)
/tools/audit/audit.config.local.json

# Unity integration pipeline: track the tool sources, ignore regenerable bulk evidence.
# The allowlist must precede the re-ignores below, or it would re-expose out/ and converted/.
!/tools/unity-rebuild/
/tools/unity-rebuild/out/
/tools/unity-rebuild/work/
/tools/unity-rebuild/converted/
/tools/unity-rebuild/*.log

# Unity project: keep the authored project, ignore generated caches and build output
/UnityProject/Library/
/UnityProject/Temp/
/UnityProject/Obj/
/UnityProject/Logs/
/UnityProject/UserSettings/
/UnityProject/Build/
/UnityProject/Builds/
/UnityProject/Recordings/
/UnityProject/[Bb]uild[Ll]ogs/
/UnityProject/*.csproj
/UnityProject/*.sln
/UnityProject/*.user
/UnityProject/Assets/AddressableAssetsData/AssetGroups/*.asset.tmp

# Build output
/dist/
**/bin/
**/obj/

# Large regenerable IL2CPP dump inputs (read-only analysis sources)
/src/il2cpp/dump.cs
/src/il2cpp/script.json
/src/il2cpp/il2cpp.h
/src/il2cpp/stringliteral.json
/src/il2cpp/DummyDll/

# Reference decompilation of Unity/System/third-party libs (not our target)
/src/decompiled_external/

# Bulk extraction manifests/logs from the asset-ripping phase
/work/manifest_*.jsonl
/work/*.log
/work/*.txt
/work/__pycache__/
/work/done_*/
/work/claims_audio/
/work/probe_out/

.idea/

# reversing caches (regenerable: il2cpp_db.py / sweep.py)
work/reversing/*.pkl
**/__pycache__/
