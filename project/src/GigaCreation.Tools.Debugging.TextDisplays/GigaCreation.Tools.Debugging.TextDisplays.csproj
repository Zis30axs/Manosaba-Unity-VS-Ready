<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GigaCreation.Tools.Debugging.TextDisplays</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DocumentationFile></DocumentationFile>
    <NoWarn>$(NoWarn);CS0436;CS0433;CS0108;CS0114</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ManosabaSrc)\GigaCreation.Tools.Debugging.TextDisplays\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GigaCreation.Tools.Debugging.Core\GigaCreation.Tools.Debugging.Core.csproj" />
    <ProjectReference Include="..\GigaCreation.Tools.UI\GigaCreation.Tools.UI.csproj" />
    <ProjectReference Include="..\Il2CppDummyDll\Il2CppDummyDll.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UniRx">
      <HintPath>$(ManosabaRefs)\UniRx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManosabaRefs)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManosabaRefs)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
