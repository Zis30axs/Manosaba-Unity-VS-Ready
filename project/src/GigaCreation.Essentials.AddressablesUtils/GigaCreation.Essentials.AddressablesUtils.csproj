<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GigaCreation.Essentials.AddressablesUtils</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DocumentationFile></DocumentationFile>
    <NoWarn>$(NoWarn);CS0436;CS0433;CS0108;CS0114</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ManosabaSrc)\GigaCreation.Essentials.AddressablesUtils\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GigaCreation.Essentials.MasterData\GigaCreation.Essentials.MasterData.csproj" />
    <ProjectReference Include="..\GigaCreation.Essentials.WebRequestUtils\GigaCreation.Essentials.WebRequestUtils.csproj" />
    <ProjectReference Include="..\GigaCreation.Tools.Service\GigaCreation.Tools.Service.csproj" />
    <ProjectReference Include="..\Il2CppDummyDll\Il2CppDummyDll.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UniRx">
      <HintPath>$(ManosabaRefs)\UniRx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>$(ManosabaRefs)\UniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Addressables">
      <HintPath>$(ManosabaRefs)\Unity.Addressables.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.ResourceManager">
      <HintPath>$(ManosabaRefs)\Unity.ResourceManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManosabaRefs)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
