<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- NuGet 缓存放在仓库内的 tools\nuget（相对路径，整个目录可以随便搬盘） -->
  <config>
    <add key="globalPackagesFolder" value="..\tools\nuget" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>